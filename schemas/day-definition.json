      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "$ref": "#/definitions/SaintCount"
            },
            {
              "type": "null"
            }
          ],
          "description": "Specify the number of persons this martyrology item is representing."
        },
        "hide_titles": {
          "description": "Specify if titles should not be displayed. This can occur when a title is already included in the name of the martyrology item.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "description": "The ID of the martyrology item.",
          "type": "string"
        },
        "titles": {
          "anyOf": [
            {
              "$ref": "#/definitions/TitlesDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The redefined titles of the martyrology item."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "MonthIndex": {
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
