{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Colors": {
      "enum": [
        "RED",
        "ROSE",
        "PURPLE",
        "GREEN",
        "WHITE",
        "GOLD",
        "BLACK"
      ],
      "type": "string"
    },
    "ColorsDef": {
      "anyOf": [
        {
          "$ref": "#/definitions/Colors"
        },
        {
          "items": {
            "$ref": "#/definitions/Colors"
          },
          "type": "array"
        }
      ]
    },
    "CommonDefinition": {
      "enum": [
        "NONE",
        "DEDICATION_ANNIVERSARY__INSIDE",
        "DEDICATION_ANNIVERSARY__OUTSIDE",
        "BLESSED_VIRGIN_MARY",
        "MARTYRS",
        "MISSIONARY_MARTYRS",
        "VIRGIN_MARTYRS",
        "WOMAN_MARTYRS",
        "PASTORS",
        "POPES",
        "BISHOPS",
        "FOUNDERS",
        "MISSIONARIES",
        "DOCTORS_OF_THE_CHURCH",
        "VIRGINS",
        "SAINTS",
        "ABBOTS",
        "MONKS",
        "NUNS",
        "RELIGIOUS",
        "MERCY_WORKERS",
        "EDUCATORS",
        "HOLY_WOMEN"
      ],
      "type": "string"
    },
    "CommonsDef": {
      "anyOf": [
        {
          "$ref": "#/definitions/CommonDefinition"
        },
        {
          "items": {
            "$ref": "#/definitions/CommonDefinition"
          },
          "type": "array"
        }
      ]
    },
    "CompoundTitle": {
      "additionalProperties": false,
      "properties": {
        "append": {
          "description": "Add title(s) to the end of the existing list of title(s).",
          "items": {
            "$ref": "#/definitions/Title"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "prepend": {
          "description": "Add title(s) to the beginning of the existing list of title(s).",
          "items": {
            "$ref": "#/definitions/Title"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DateDef": {
      "anyOf": [
        {
          "$ref": "#/definitions/DateDefMonthDate"
        },
        {
          "$ref": "#/definitions/DateDefDateFnAddDay"
        },
        {
          "$ref": "#/definitions/DateDefDateFnSubtractDay"
        },
        {
          "$ref": "#/definitions/DateDefMonthDowNthWeekInMonth"
        },
        {
          "$ref": "#/definitions/DateDefMonthLastDowInMonth"
        }
      ]
    },
    "DateDefAddDay": {
      "additionalProperties": false,
      "properties": {
        "add_day": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "add_day"
      ],
      "type": "object"
    },
    "DateDefDateFnAddDay": {
      "additionalProperties": false,
      "properties": {
        "add_day": {
          "description": "Add additional day(s) to the date computed from the 'dateFn' option.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "date_args": {
          "description": "Possible date function arguments that may be required.",
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "date_fn": {
          "allOf": [
            {
              "$ref": "#/definitions/DateFn"
            }
          ],
          "description": "A date function name from the [Date] class."
        },
        "year_offset": {
          "description": "Offset the current year to compute dates in the scope of different years.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "date_fn"
      ],
      "type": "object"
    },
    "DateDefDateFnSubtractDay": {
      "additionalProperties": false,
      "properties": {
        "date_args": {
          "description": "Possible date function arguments that may be required.",
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "date_fn": {
          "allOf": [
            {
              "$ref": "#/definitions/DateFn"
            }
          ],
          "description": "A date function name from the [Date] class."
        },
        "subtract_day": {
          "description": "Subtract some day(s) to the date computed from the 'dateFn' option.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "year_offset": {
          "description": "Offset the current year to compute dates in the scope of different years.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "date_fn"
      ],
      "type": "object"
    },
    "DateDefException": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Add an exception if the computed date occurs between two dates",
          "properties": {
            "if_is_between": {
              "$ref": "#/definitions/IfIsBetweenFields"
            },
            "set_date": {
              "$ref": "#/definitions/DateDefExtended"
            }
          },
          "required": [
            "if_is_between",
            "set_date"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Add an exception if the computed date occurs the same day as another date",
          "properties": {
            "if_is_same_as_date": {
              "$ref": "#/definitions/DateDef"
            },
            "set_date": {
              "$ref": "#/definitions/DateDefExtended"
            }
          },
          "required": [
            "if_is_same_as_date",
            "set_date"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Add an exception if the computed date occurs on a specific day of week",
          "properties": {
            "if_is_day_of_week": {
              "$ref": "#/definitions/DayOfWeek"
            },
            "set_date": {
              "$ref": "#/definitions/DateDefExtended"
            }
          },
          "required": [
            "if_is_day_of_week",
            "set_date"
          ],
          "type": "object"
        }
      ],
      "description": "The liturgical day date exception Represents a condition and the date to set when that condition is met"
    },
    "DateDefExtended": {
      "anyOf": [
        {
          "$ref": "#/definitions/DateDef"
        },
        {
          "$ref": "#/definitions/DateDefAddDay"
        },
        {
          "$ref": "#/definitions/DateDefSubtractDay"
        }
      ]
    },
    "DateDefMonthDate": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "The date of this liturgical day.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "month": {
          "allOf": [
            {
              "$ref": "#/definitions/MonthIndex"
            }
          ],
          "description": "The month of this liturgical day."
        },
        "year_offset": {
          "description": "Offset the current year to compute dates in the scope of different years.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "date",
        "month"
      ],
      "type": "object"
    },
    "DateDefMonthDowNthWeekInMonth": {
      "additionalProperties": false,
      "properties": {
        "day_of_week": {
          "allOf": [
            {
              "$ref": "#/definitions/DayOfWeek"
            }
          ],
          "description": "The day of week this liturgical year must occur."
        },
        "month": {
          "allOf": [
            {
              "$ref": "#/definitions/MonthIndex"
            }
          ],
          "description": "The month of this liturgical day."
        },
        "nth_week_in_month": {
          "description": "The nth week in the month this liturgical year must occur.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "year_offset": {
          "description": "Offset the current year to compute dates in the scope of different years.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "day_of_week",
        "month",
        "nth_week_in_month"
      ],
      "type": "object"
    },
    "DateDefMonthLastDowInMonth": {
      "additionalProperties": false,
      "properties": {
        "last_day_of_week_in_month": {
          "allOf": [
            {
              "$ref": "#/definitions/DayOfWeek"
            }
          ],
          "description": "The last day of week in the month this liturgical year must occur."
        },
        "month": {
          "allOf": [
            {
              "$ref": "#/definitions/MonthIndex"
            }
          ],
          "description": "The month of this liturgical day."
        },
        "year_offset": {
          "description": "Offset the current year to compute dates in the scope of different years.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "last_day_of_week_in_month",
        "month"
      ],
      "type": "object"
    },
    "DateDefSubtractDay": {
      "additionalProperties": false,
      "properties": {
        "subtract_day": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "subtract_day"
      ],
      "type": "object"
    },
