      "enum": [
        "MARY_MOTHER_OF_THE_CHURCH",
        "EPIPHANY_SUNDAY",
        "PRESENTATION_OF_THE_LORD",
        "ANNUNCIATION",
        "PALM_SUNDAY",
        "EASTER_SUNDAY",
        "DIVINE_MERCY_SUNDAY",
        "IMMACULATE_HEART_OF_MARY",
        "PENTECOST_SUNDAY",
        "CORPUS_CHRISTI_SUNDAY",
        "NATIVITY_OF_JOHN_THE_BAPTIST",
        "PETER_AND_PAUL_APOSTLES",
        "TRANSFIGURATION",
        "ASSUMPTION",
        "EXALTATION_OF_THE_HOLY_CROSS",
        "ALL_SAINTS",
        "IMMACULATE_CONCEPTION_OF_MARY"
      ],
      "type": "string"
    },
    "DayOfWeek": {
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    },
    "IfIsBetweenFields": {
      "additionalProperties": false,
      "description": "Fields for the \"if_is_between\" condition",
      "properties": {
        "from": {
          "$ref": "#/definitions/DateDef"
        },
        "inclusive": {
          "type": "boolean"
        },
        "to": {
          "$ref": "#/definitions/DateDef"
        }
      },
      "required": [
        "from",
        "inclusive",
        "to"
      ],
      "type": "object"
    },
    "MartyrologyItemPointer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/MartyrologyItemRedefined"
        }
      ]
