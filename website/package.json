{
  "name": "romcal-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "watch-docs": "chokidar \"../docs/**/*\" -c \"pnpm sync-docs\"",
    "dev": "pnpm sync-docs && run-p watch-docs dev:astro",
    "dev:astro": "astro dev",
    "start": "pnpm dev",
    "build": "pnpm sync-docs && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.37.4",
    "@fontsource/crimson-text": "^5.2.7",
    "astro": "^5.6.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1"
  }
}
