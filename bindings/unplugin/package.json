{
  "name": "@romcal/unplugin",
  "version": "4.0.0-beta.5",
  "description": "Bundler plugin for romcal data optimization",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "import": "./dist/rolldown.js"
    },
    "./farm": {
      "types": "./dist/farm.d.ts",
      "import": "./dist/farm.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Étienne Magnier",
    "email": "etienne.magnier@gmail.com",
    "url": "https://github.com/emagnier"
  },
  "keywords": [
    "romcal",
    "liturgical",
    "calendar",
    "unplugin",
    "vite",
    "rollup",
    "webpack",
    "esbuild",
    "rspack",
    "rolldown",
    "farm",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romcal/romcal.git",
    "directory": "bindings/unplugin"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "romcal": "^4.0.0"
  },
  "dependencies": {
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "romcal": "link:../typescript",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "license": "Apache-2.0"
}
