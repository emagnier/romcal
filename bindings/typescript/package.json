{
  "name": "romcal",
  "version": "4.0.0-beta.3",
  "description": "Liturgical calendar library for calculating Catholic liturgical dates and calendars",
  "type": "module",
  "main": "./dist/romcal.js",
  "module": "./dist/romcal.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/romcal.js",
      "default": "./dist/romcal.umd.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "pkg"
  ],
  "keywords": [
    "liturgical",
    "calendar",
    "catholic",
    "christian",
    "easter",
    "romcal",
    "wasm"
  ],
  "author": {
    "name": "Étienne Magnier",
    "email": "etienne.magnier@gmail.com",
    "url": "https://github.com/emagnier"
  },
  "contributors": [
    {
      "name": "Julian Pereira",
      "email": "bleushade@gmail.com",
      "url": "https://github.com/pejulian"
    },
    {
      "name": "Tukusej's Sirs",
      "email": "tukusejssirs@protonmail.com",
      "url": "https://github.com/tukusejssirs"
    },
    {
      "name": "Matej Voboril",
      "email": "tobiah@pm.me",
      "url": "https://github.com/TobiTenno"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/romcal/romcal"
  },
  "homepage": "https://romcal.dev",
  "bugs": {
    "url": "https://github.com/romcal/romcal/issues"
  },
  "scripts": {
    "build": "npm run build:wasm && npm run generate-types && npm run build:vite",
    "build:vite": "vite build",
    "build:wasm": "wasm-pack build ../wasm --target web --out-dir ../typescript/pkg",
    "generate-types": "cd ../../core && TS_RS_EXPORT_DIR=../bindings/typescript/src/types cargo test --features ts-bindings --quiet && cd ../bindings/typescript && npm run generate-types:fix-imports && echo 'TypeScript types generated in src/types/'",
    "generate-types:fix-imports": "sed -i '' '1a\\\nimport type { LiturgicalCycle } from \"./LiturgicalCycle.js\";\\\nimport type { MassContent } from \"./MassContent.js\";\n' src/types/MassCycleDefinition.ts && sed -i '' '1a\\\nimport type { MassTime } from \"./MassTime.js\";\\\nimport type { MassCycleDefinition } from \"./MassCycleDefinition.js\";\n' src/types/MassesDefinitions.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --project browser",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  },
  "license": "Apache-2.0"
}
