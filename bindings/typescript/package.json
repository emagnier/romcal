{
  "name": "romcal",
  "version": "4.0.0",
  "description": "Liturgical calendar library for calculating Catholic liturgical dates and calendars",
  "type": "module",
  "main": "./dist/romcal.js",
  "module": "./dist/romcal.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/romcal.js",
      "default": "./dist/romcal.umd.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "pkg"
  ],
  "keywords": [
    "liturgical",
    "calendar",
    "catholic",
    "christian",
    "easter",
    "romcal",
    "wasm"
  ],
  "author": {
    "name": "Étienne Magnier",
    "email": "etienne.magnier@gmail.com",
    "url": "https://github.com/emagnier"
  },
  "contributors": [
    {
      "name": "Julian Pereira",
      "email": "bleushade@gmail.com",
      "url": "https://github.com/pejulian"
    },
    {
      "name": "Tukusej's Sirs",
      "email": "tukusejssirs@protonmail.com",
      "url": "https://github.com/tukusejssirs"
    },
    {
      "name": "Matej Voboril",
      "email": "tobiah@pm.me",
      "url": "https://github.com/TobiTenno"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/romcal/romcal"
  },
  "homepage": "https://romcal.dev",
  "bugs": {
    "url": "https://github.com/romcal/romcal/issues"
  },
  "scripts": {
    "build": "npm run build:wasm && npm run build:vite",
    "build:vite": "vite build",
    "build:wasm": "wasm-pack build ../../core/adapters/wasm --target web --out-dir ../../../bindings/typescript/pkg",
    "generate-types": "quicktype --src ../../schemas/all_types.json --src-lang schema --lang typescript --top-level AllTypes --out src/types.ts --explicit-unions --no-combine-classes --just-types --prefer-types",
    "test": "tsx test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "quicktype": "^23.2.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "Apache-2.0"
}
