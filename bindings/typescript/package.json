{
  "name": "romcal",
  "version": "4.0.0-beta.5",
  "description": "Liturgical calendar library for calculating Catholic liturgical dates and calendars",
  "type": "module",
  "main": "./dist/romcal.js",
  "module": "./dist/romcal.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/romcal.js",
      "default": "./dist/romcal.umd.js"
    },
    "./definitions": {
      "types": "./dist/definitions/index.d.ts",
      "import": "./dist/definitions/index.js"
    },
    "./definitions/*": {
      "types": "./dist/definitions/*.d.ts",
      "import": "./dist/definitions/*.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js"
    },
    "./resources/*": {
      "types": "./dist/resources/*.d.ts",
      "import": "./dist/resources/*.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "files": [
    "dist",
    "pkg"
  ],
  "keywords": [
    "liturgical",
    "calendar",
    "catholic",
    "christian",
    "easter",
    "romcal",
    "wasm"
  ],
  "author": {
    "name": "Étienne Magnier",
    "email": "etienne.magnier@gmail.com",
    "url": "https://github.com/emagnier"
  },
  "contributors": [
    {
      "name": "Julian Pereira",
      "email": "bleushade@gmail.com",
      "url": "https://github.com/pejulian"
    },
    {
      "name": "Tukusej's Sirs",
      "email": "tukusejssirs@protonmail.com",
      "url": "https://github.com/tukusejssirs"
    },
    {
      "name": "Matej Voboril",
      "email": "tobiah@pm.me",
      "url": "https://github.com/TobiTenno"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romcal/romcal.git"
  },
  "homepage": "https://romcal.dev",
  "bugs": {
    "url": "https://github.com/romcal/romcal/issues"
  },
  "scripts": {
    "build": "pnpm build:wasm && pnpm build:vite && pnpm generate-data",
    "build:vite": "vite build",
    "build:wasm": "wasm-pack build ../wasm --target web --out-dir ../typescript/pkg",
    "generate-data": "tsx scripts/generate-data.ts",
    "generate-types": "cd ../../core && TS_RS_EXPORT_DIR=../bindings/typescript/src/types TS_RS_IMPORT_EXTENSION=.js cargo test --features ts-bindings --quiet && cd ../bindings/typescript && tsx scripts/fix-imports.ts && pnpm exec prettier --write src/types/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --project browser",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "glob": "^13.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "license": "Apache-2.0"
}
