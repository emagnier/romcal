{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Test: romcal (Rust lib)",
      "cargo": {
        "args": ["test", "--package=romcal", "--lib"]
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Test: romcal-cli (Rust)",
      "cargo": {
        "args": ["test", "--package=romcal-cli"]
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Test: TypeScript bindings",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["vitest", "run"],
      "cwd": "${workspaceFolder}/bindings/typescript",
      "console": "integratedTerminal"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Test: Python bindings",
      "python": "${workspaceFolder}/bindings/python/.venv/bin/python",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}/bindings/python",
      "console": "integratedTerminal"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Run: validate-json (resources)",
      "cargo": {
        "args": ["run", "--package=romcal-tools", "--bin=validate-json", "--"]
      },
      "args": ["data/resources/**/*.json", "schemas/resources.json", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}/tools"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Run: validate-json (calendars)",
      "cargo": {
        "args": ["run", "--package=romcal-tools", "--bin=validate-json", "--"]
      },
      "args": ["data/definitions/**/*.json", "schemas/calendar_definition.json", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}/tools"
    }
  ]
}
